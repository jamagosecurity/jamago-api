# Jama Go — nginx site for jamago.qa
# Frontend: /var/www/jamago.qa
# API:      http://127.0.0.1:5093  (proxied at /api/)

server {
    listen 80;
    listen [::]:80;
    server_name jamago.qa www.jamago.qa;

    # Redirect HTTP → HTTPS if certbot manages TLS (certbot will adjust this block).
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name jamago.qa www.jamago.qa;

    # Managed by Certbot — keep existing paths if already present:
    # ssl_certificate     /etc/letsencrypt/live/jamago.qa/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/jamago.qa/privkey.pem;
    # include             /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/jamago.qa;
    index index.html;

    client_max_body_size 10m;

    # ^~ so the regex asset locations below cannot capture an API route that
    # happens to end in .js or .css — a regex match otherwise beats this prefix.
    location ^~ /api/ {
        proxy_pass         http://127.0.0.1:5093;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
    }

    # Build artefacts carry a content hash in the filename, so a new build is a
    # new URL — they can be cached indefinitely.
    location ~* \.(?:js|css)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Self-hosted fonts, served from a fixed path with stable content.
    location /fonts/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Images are not content-hashed, so keep the window short enough to replace them.
    location ~* \.(?:png|jpe?g|gif|svg|webp|avif|ico)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=2592000";
    }

    # A 404 must never be cacheable, whichever location produced it.
    #
    # scp uploads a build one file at a time, so a bundle is briefly absent
    # mid-deploy. With `always` on the rule above, that 404 was served carrying
    # "immutable, max-age=1y" — so a single request landing in that window
    # pinned a 404 for main.js at the CDN for a year, and every visitor got a
    # blank page while the file sat on disk perfectly intact.
    #
    # Dropping `always` is the actual fix: nginx then applies the cache-forever
    # header only to 2xx/3xx, which is all it was ever meant to cover. This
    # block is the belt to that braces.
    error_page 404 = @notfound;
    location @notfound {
        add_header Cache-Control "no-store" always;
        return 404;
    }

    # Angular SPA routes and prerendered HTML. HTML must revalidate every time or
    # a deploy goes unnoticed while clients hold a stale shell.
    #
    # The fallback is index.csr.html — the EMPTY shell — and not index.html,
    # which is the prerendered HOME page. Falling back to index.html served the
    # marketing site's markup to anyone opening /admin/login or /admin/staff
    # directly: the visitor watched the home page render, then had it replaced
    # once Angular booted and routed them.
    #
    # $uri/index.html comes before $uri/ so the prerendered pages that live in a
    # directory — contact/, sifeddine/ — still resolve to their own real file
    # rather than falling through to the shell and losing their prerendering.
    location / {
        try_files $uri $uri/index.html $uri/ /index.csr.html;
        add_header Cache-Control "no-cache" always;
    }
}
