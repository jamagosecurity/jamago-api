<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>Jama.Infrastructure</RootNamespace>

  </PropertyGroup>



  <ItemGroup>

    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>



  <ItemGroup>

    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">

      <PrivateAssets>all</PrivateAssets>

      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>

    </PackageReference>

    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.0" />

    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />

    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Stamps a watermark onto an already-uploaded drawing PDF. QuestPDF only
         builds new documents from scratch — it cannot open and mark up one that
         already exists, which a drawing's plotted PDF always is. -->
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />

    <!-- PdfSharpCore pulls in SixLabors.ImageSharp 1.0.4, which carries several
         known high-severity CVEs (decompression-bomb DoS, out-of-bounds read).
         This code path runs on an attacker-uploadable file — a drawing's PDF —
         so the vulnerable transitive version is not acceptable here. Pinned
         directly to force the patched release; NuGet resolves a direct
         reference over a transitive one. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

    <PackageReference Include="QuestPDF" Version="2025.7.1" />

    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />

  </ItemGroup>



  <ItemGroup>

    <ProjectReference Include="..\Jama.Application\Jama.Application.csproj" />

    <ProjectReference Include="..\Jama.Domain\Jama.Domain.csproj" />

  </ItemGroup>



  <ItemGroup>

    <!-- The document helpers stay internal, but the money-in-words sentences are
         worth pinning directly rather than only through a rendered PDF. -->

    <InternalsVisibleTo Include="Jama.Application.Tests" />

  </ItemGroup>



  <ItemGroup>

    <EmbeddedResource Include="Documents\Assets\jamago-logo.png" />

    <EmbeddedResource Include="Documents\Assets\jamago-logo-watermark.png" />
    <EmbeddedResource Include="Documents\Assets\jamago-quote-watermark.png" />
    <EmbeddedResource Include="Documents\Assets\brands\*.webp" />

    <!-- The Arabic face for the bilingual lines on a quotation. Carried in the
         assembly rather than named and hoped for: the server has no Arabic font
         installed, and QuestPDF throws on a glyph it cannot draw. SIL Open Font
         License 1.1 — see Documents/Assets/OFL.txt. -->
    <EmbeddedResource Include="Documents\Assets\noto-naskh-arabic-regular.ttf" />
    <EmbeddedResource Include="Documents\Assets\noto-naskh-arabic-bold.ttf" />

    <!-- Static QR to www.jamago.qa, printed in the corner of the proposal pages.
         Pre-rendered rather than generated at run time: the URL never changes, so
         a build-time asset costs nothing and keeps a QR library out of the API. -->
    <EmbeddedResource Include="Documents\Assets\jamago-qr.png" />

    <!-- The company stamp for MOI submissions. Conditional: the generator prints
         without it, so a missing file must not break the build. -->
    <EmbeddedResource Include="Documents\Assets\jamago-stamp.png" Condition="Exists('Documents\Assets\jamago-stamp.png')" />

  </ItemGroup>



</Project>

